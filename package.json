{
  "name": "kite-x402-hono",
  "version": "0.3.2",
  "description": "Bun and Hono reverse proxy for x402 payments on Kite",
  "type": "module",
  "license": "Apache-2.0",
  "author": "BrK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrKDDD/kite-x402-hono.git"
  },
  "homepage": "https://github.com/BrKDDD/kite-x402-hono#readme",
  "bugs": {
    "url": "https://github.com/BrKDDD/kite-x402-hono/issues"
  },
  "keywords": [
    "kite",
    "x402",
    "hono",
    "bun",
    "payments"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs",
    ".env.example",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kite-x402-hono": "dist/cli.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
    "example": "bun examples/upstream.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@x402/core": "2.26.0",
    "@x402/evm": "2.26.0",
    "@x402/hono": "2.26.0",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  }
}
